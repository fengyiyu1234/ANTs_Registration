__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/
.DS_Store
configs/**/*.yaml
!configs/**/*.example.yaml
data/
atlas/
# stats/ working configs, same convention as configs/ above: the tracked
# *.example.yaml is the template (it carries real paths, so copying it is
# enough to run), the working copy next to it stays local.
stats/configs/**/*.yaml
!stats/configs/**/*.example.yaml

# per-script local path configs -- real paths live in *_local.yaml, gitignored
# so editing them isn't a git diff.
*_local.yaml
# startup-failure breadcrumb from run_pipeline.sh (see its header)
run_pipeline.error.log
*.md

# one-off batch helpers (sample tables, config generators, Slurm scripts, QC) -- local only,
# same convention as brain_detector/local_scripts/.
local_scripts/
# temporary symlink to local_scripts/run_batch.py for Slurm tasks queued before the move
# (2026-11-18 batch); delete it once that batch is done.
scripts/run_batch.py
