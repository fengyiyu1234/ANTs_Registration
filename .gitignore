__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/
.DS_Store
configs/*.yaml
!configs/config.example.yaml
!configs/atlas_presets.example.yaml
data/
atlas/
# stats/ working configs, same convention as configs/ above: the tracked
# *.example.yaml is the template (it carries real paths, so copying it is
# enough to run), the working copy next to it stays local.
stats/configs/*.yaml
!stats/configs/*.example.yaml

# per-script local path configs -- real paths live in *_local.yaml, gitignored
# so editing them isn't a git diff.
*_local.yaml
# startup-failure breadcrumb from run_pipeline.sh (see its header)
run_pipeline.error.log
